{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_linter/src/rules.rs",
  "rules": {
    "unicorn/no-empty-file": "warn",
    "no-console": "error",
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-vars": "off"
  },
  "plugins": ["react", "typescript", "unicorn"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["node_modules", "dist", ".wrangler", "*.config.ts", "*.config.js", "coverage"]
}
