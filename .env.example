# ============================================================
# Workshop — Required Environment Variables
# ============================================================
# IMPORTANT: Do NOT set default/fallback values.
# The application WILL CRASH if any required variable is missing.
# This is intentional — silent misconfigurations are worse than crashes.
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================


# ── Google OAuth 2.0 ────────────────────────────────────────
# Obtain from: https://console.cloud.google.com/apis/credentials
# Callback URL must match: https://api.workshop.zeonweb.com/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=


# ── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
# Must be at least 32 characters. Keep this secret.

JWT_SECRET=


# ── Cloudflare D1 (SQLite Database) ─────────────────────────
# Obtained from Cloudflare dashboard → Workers & Pages → D1
# Used locally in wrangler.toml binding, not a runtime env var.
# Listed here for documentation purposes.

CLOUDFLARE_D1_DATABASE_ID=


# ── Cloudflare R2 (Object Storage) ──────────────────────────
# Obtained from Cloudflare dashboard → R2 Object Storage
# Used locally in wrangler.toml binding, not a runtime env var.
# Listed here for documentation purposes.

CLOUDFLARE_R2_BUCKET_NAME=


# ── Cloudflare Account ───────────────────────────────────────
# Required for Wrangler deploy via GitHub Actions CI/CD

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=


# ── Frontend (apps/web) ──────────────────────────────────────
# Vite exposes variables prefixed with VITE_ to the browser.

VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
